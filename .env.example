# ─── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# ─── NestJS API ────────────────────────────────────────────────────────────────
# "production" desactiva Swagger y la sincronización automática del esquema.
NODE_ENV=development
# El registro solo crea la primera cuenta; ponlo en true para abrirlo temporalmente.
ALLOW_REGISTRATION=false
API_PORT=
JWT_SECRET=
JWT_EXPIRES_IN=
# Orígenes permitidos por CORS, separados por coma. Vacío = refleja cualquiera (solo dev).
CORS_ORIGIN=http://localhost:5173

# ─── Microservicio ML (FastAPI) ────────────────────────────────────────────────
ML_SERVICE_URL=http://127.0.0.1:8001
# Carpeta con churn_pipeline.pkl y model_metadata.json (opcional; para Docker).
# MODEL_DIR=/models

# ─── Frontend ──────────────────────────────────────────────────────────────────
VITE_API_URL=
